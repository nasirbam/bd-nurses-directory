# GEMINI_API_KEY: Unused in this app (Supabase backend is used instead).
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=YOUR_SUPABASE_URL

# SUPABASE_ANON_KEY: Your Supabase project anon/public API key
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional EmailJS configuration for sending 6-digit password recovery emails
EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
